  "npcs": {},
  "dialogues": {
    "haruhi:fixture/clerk": {
      "start": "greet",
      "nodes": {
        "greet": {
          "text": "Welcome to the counter.",
          "choices": [
            {
              "text": "Remember me?",
              "next": "remembered",
              "only_if": [
                {
                  "type": "haruhi:flag",
                  "namespace": "haruhi:fixture/clerk",
                  "flag": "met",
                  "op": "set"
                }
              ],
              "when_unavailable": "hidden"
            },
            {
              "text": "Tell me more.",
              "next": "info",
              "actions": [
                {
                  "type": "haruhi:flag/set",
                  "namespace": "haruhi:fixture/clerk",
                  "flag": "met",
                  "value": 1
                }
              ]
            },
            {
              "text": "Leave.",
              "next": "bye"
            }
          ]
        },
        "remembered": {
          "text": "Good to see you again.",
          "next": "bye"
        },
        "info": {
          "text": "We sell maps.",
          "next": "bye"
        },
        "bye": {
          "text": "Safe travels."
        }
      }
    },
    "haruhi:fixture/greeter": {
      "start": "greet",
      "nodes": {
        "greet": {
          "random": [
            {
              "node": "welcome_back",
              "weight": 1,
              "only_if": [
                {
                  "type": "haruhi:flag",
                  "namespace": "haruhi:fixture/greeter",
                  "flag": "met",
                  "op": "set"
                }
              ]
            }
          ],
          "next": "first_meeting"
        },
        "first_meeting": {
          "text": "I don't think we've met.",
          "choices": [
            {
              "text": "Nice to meet you.",
              "next": "greet",
              "actions": [
                {
                  "type": "haruhi:flag/set",
                  "namespace": "haruhi:fixture/greeter",
                  "flag": "met",
                  "value": 1
                }
              ]
            },
            {
              "text": "Leave.",
              "next": "bye"
            }
          ]
        },
        "welcome_back": {
          "text": "Good to see you again.",
          "next": "bye"
        },
        "bye": {
          "text": "See you."
        }
      }
    },
    "haruhi:fixture/gate": {
      "start": "menu",
      "nodes": {
        "menu": {
          "text": "The door is locked.",
          "choices": [
            {
              "text": "Locked door",
              "next": "bye",
              "only_if": [
                {
                  "type": "haruhi:flag",
                  "namespace": "haruhi:fixture/gate",
                  "flag": "opened",
                  "op": "set"
                }
              ],
              "when_unavailable": "grayed_out",
              "unavailable_message": "It is locked."
            },
            {
              "text": "Leave.",
              "next": "bye"
            }
          ]
        },
        "bye": {
          "text": "Safe travels."
        }
      }
    },
    "haruhi:fixture/reward": {
      "start": "hand_over",
      "nodes": {
        "hand_over": {
          "text": "Here is a book for you.",
          "on_enter": [
            {
              "type": "haruhi:give",
              "loot_table": "minecraft:gameplay/hero_of_the_village/librarian_gift",
              "once": {
                "namespace": "haruhi:fixture/reward",
                "flag": "got_reward"
              }
            }
          ],
          "next": "bye"
        },
        "bye": {
          "text": "Enjoy."
        }
      }
    },
    "haruhi:fixture/world": {
      "start": "check",
      "nodes": {
        "check": {
          "text": "What do you carry?",
          "choices": [
            {
              "text": "Three apples.",
              "next": "bye",
              "only_if": [
                {
                  "type": "haruhi:has_item",
                  "item": "minecraft:apple",
                  "count": 3
                }
              ]
            },
            {
              "text": "Four apples.",
              "next": "bye",
              "only_if": [
                {
                  "type": "haruhi:has_item",
                  "item": "minecraft:apple",
                  "count": 4
                }
              ]
            },
            {
              "text": "Tagged.",
              "next": "bye",
              "only_if": [
                {
                  "type": "haruhi:tag",
                  "tag": "guild_member"
                }
              ]
            },
            {
              "text": "Anyone.",
              "next": "bye",
              "only_if": [
                {
                  "type": "haruhi:permission",
                  "level": 0
                }
              ]
            },
            {
              "text": "Admins only.",
              "next": "bye",
              "only_if": [
                {
                  "type": "haruhi:permission",
                  "level": 4
                }
              ]
            }
          ]
        },
        "bye": {
          "text": "Goodbye."
        }
      }
    },
